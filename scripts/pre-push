#!/usr/bin/env bash
#
# Versioned pre-push hook body. `.git/hooks/pre-push` is a thin shim that execs
# this, so the logic stays in the repo and survives a fresh clone.
#
# Install on a fresh clone:
#
#   ln -sf ../../scripts/pre-push .git/hooks/pre-push
#
# Escape hatches:
#   SKIP_SMOKE=1     skip just the smoke test
#   --no-verify      skip all hooks (git's own flag)

set -euo pipefail

if [ "${SKIP_SMOKE:-}" = "1" ]; then
  echo "pre-push: SKIP_SMOKE=1, skipping smoke test"
  exit 0
fi

# stdin gives one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# A local sha of all-zeros means a branch deletion — nothing to build, so if
# every ref is a deletion we have no reason to run.
ZERO="0000000000000000000000000000000000000000"
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue
  has_content=1
done

if [ "$has_content" -eq 0 ]; then
  echo "pre-push: nothing but deletions, skipping smoke test"
  exit 0
fi

echo "pre-push: running docs smoke test (SKIP_SMOKE=1 to skip)"

if ! "$(git rev-parse --show-toplevel)/scripts/smoke-test.sh"; then
  echo ""
  echo "pre-push: smoke test failed — push aborted."
  echo "          Fix the broken links above, or re-run with SKIP_SMOKE=1 to bypass."
  exit 1
fi
