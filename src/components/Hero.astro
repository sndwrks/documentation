---
/**
 * Hero override: full-bleed landing hero — headline, tagline and actions
 * stacked top-left, animated globe centered in the same grid cell behind
 * them. On mobile the globe dims to a backdrop under the copy. The card
 * grid band follows directly below.
 */
import { LinkButton } from '@astrojs/starlight/components';
import Globe from './Globe.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero sw-hero">
	<div class="sw-hero-content">
		<div class="sw-hero-copy">
			<h1 id="_top" data-page-title class="sw-hero-title" set:html={title} />
			{tagline && <div class="sw-hero-tagline" set:html={tagline} />}
			{
				actions.length > 0 && (
					<div class="sw-hero-actions">
						{actions.map(
							({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
								<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
									{text}
									{icon?.html && <Fragment set:html={icon.html} />}
								</LinkButton>
							)
						)}
					</div>
				)
			}
		</div>
	</div>
	<Globe />
</div>

<style>
	/* copy and globe share one grid cell: the globe centers in the hero box
	   regardless of how tall the copy stack gets */
	.sw-hero {
		position: relative;
		display: grid;
		grid-template-areas: 'stack';
		overflow: hidden;
		padding: clamp(1.25rem, 3vh, 2rem) var(--sw-section-pad-x) 0.5rem;
	}

	/* stretched so the copy's percentage max-width resolves against a
	   definite width — a shrink-to-fit parent would collapse it */
	.sw-hero-content {
		grid-area: stack;
		z-index: 2;
		justify-self: stretch;
		align-self: start;
	}

	.sw-hero-copy {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		/* keep the stack clear of the globe's dense middle */
		max-width: min(34rem, 48%);
	}

	.sw-hero-title {
		font-size: clamp(2rem, 4.5vw, 3.75rem);
		line-height: 1.02;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-text);
		max-width: 18ch;
		margin: 0;
	}

	.sw-hero-tagline {
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-sm);
		letter-spacing: 0.05em;
		color: var(--color-text-soft);
	}

	.sw-hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	:global(.sw-globe) {
		grid-area: stack;
		z-index: 1;
		justify-self: center;
		align-self: center;
		width: min(60vmin, 34rem);
		aspect-ratio: 1;
	}

	/* tight desktop: a 34rem globe crowds a 34rem copy column */
	@media (min-width: 50rem) and (max-width: 64rem) {
		:global(.sw-globe) {
			width: min(52vmin, 26rem);
		}
	}

	/* mobile: globe dims to a centered backdrop, copy rides on top */
	@media (max-width: 49.9375rem) {
		.sw-hero {
			padding-block: clamp(2rem, 8vh, 3.5rem);
		}
		.sw-hero-content {
			justify-self: stretch;
			align-self: center;
		}
		.sw-hero-copy {
			max-width: none;
		}
		:global(.sw-globe) {
			width: min(88vw, 22rem);
			opacity: 0.6;
		}
	}
</style>
